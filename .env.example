# Database for Drizzle commands. Matches docker-compose.yml.
DATABASE_URL=postgresql://opensunsama:opensunsama@localhost:5432/opensunsama

# Auth (if using external auth)
# AUTH_SECRET=your-secret-key

# Neon Database (if using Neon)
# NEON_DATABASE_URL=postgres://...

# Environment
NODE_ENV=development


# Redis
REDIS_URL=redis://...

# Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@opensunsama.com
