# Database: matches the PostgreSQL started by `docker compose up -d postgres`.
# Used by `bun run db:migrate` and the other db:* scripts.
DATABASE_URL=postgresql://opensunsama:opensunsama@localhost:5431/opensunsama

# ── Self-hosting with Docker (`docker compose up -d --build`) ──
# Everything below is optional for a local trial on http://localhost:3000.
# On a server, set your public URLs, then rebuild (the web app bakes API_URL in).
# API_URL=https://api.tasks.example.com
# WEB_APP_URL=https://tasks.example.com
# POSTGRES_PASSWORD=change-me   # only read when the database volume is first created
# JWT_SECRET=                   # generated on first start when unset; or: openssl rand -base64 32
# CALENDAR_ENCRYPTION_KEY=      # generated on first start when unset; or: openssl rand -hex 32

# Redis (optional; only needed to run more than one API instance)
# REDIS_URL=redis://localhost:6379

# Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@opensunsama.com
