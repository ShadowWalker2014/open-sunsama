# Schema sync — brings the database up to date with packages/database/src/schema.
# Run as a one-shot compose service before the API starts.
#
# This uses `drizzle-kit push` rather than `drizzle-kit migrate` because the
# committed migration chain does not apply cleanly: 0003_perpetual_wonder_man.sql
# re-adds tasks.actual_mins, which 0002_add_actual_mins.sql already added, so
# `migrate` aborts with 42701 on any fresh database. `push` diffs the live schema
# against src/schema directly and skips the chain. No journal rows are written,
# which is fine locally but is not a production migration path.
#
# The stanza below is byte-identical to the builder stage of Dockerfile.api so
# Docker reuses those cached layers instead of re-running `bun install`.
FROM oven/bun:1.2.21

WORKDIR /app

# Copy root package files, lockfile, and base tsconfig
COPY package.json bun.lock turbo.json tsconfig.base.json ./

# Copy ALL package.json files first (needed for workspace resolution)
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/database/package.json ./packages/database/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/api-client/package.json ./packages/api-client/

# Install dependencies (allow lockfile updates for cross-platform compatibility)
RUN bun install

# Schema, generated SQL and the drizzle journal
COPY packages/database/ ./packages/database/

WORKDIR /app/packages/database

# drizzle.config.ts reads DATABASE_URL from the environment. Its dotenv call
# looks for a root .env that is not present in the image (see .dockerignore)
# and silently no-ops, so the compose-supplied value is what gets used.
#
# --force skips the interactive confirmation prompt; there is no TTY here.
CMD ["bunx", "drizzle-kit", "push", "--force"]
