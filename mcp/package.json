{
  "name": "@open-sunsama/mcp",
  "version": "1.3.0",
  "description": "MCP server for Open Sunsama tasks, calendar, and Ideas",
  "type": "module",
  "bin": {
    "open-sunsama-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test:live": "bun run tests/test-all.ts",
    "test:tasks": "bun run tests/test-tasks.ts",
    "test:time-blocks": "bun run tests/test-time-blocks.ts",
    "test:subtasks": "bun run tests/test-subtasks.ts",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "task-management",
    "calendar",
    "sunsama"
  ]
}
